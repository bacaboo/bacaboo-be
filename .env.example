PORT=3000
NODE_ENV=development

# Ganti GANTI_PASSWORD_POSTGRES dengan password user postgres di komputermu
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_POSTGRES@localhost:5432/bacaboo

# Teks acak yang panjang dan rahasia (cara membuatnya ada di README)
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Alamat front end yang diizinkan, pisahkan dengan koma.
# Kosongkan saat pengembangan.
CORS_ORIGIN=
